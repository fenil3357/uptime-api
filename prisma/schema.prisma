generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(uuid())
  name           String
  email          String       @unique
  password       String?
  email_verified Boolean      @default(false)
  auth_provider  AuthProvider
  monitors       Int          @default(3)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  avatar         String?
  Monitor        Monitor[]
}

model Monitor {
  id        String            @id @default(uuid())
  name      String?
  user_id   String
  endpoint  String
  type      MonitorType
  is_active Boolean           @default(true)
  method    RequestMethodType @default(GET)
  payload   Json?
  headers   Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [user_id], references: [id])
  Report    Report[]
}

model Report {
  id         String         @id @default(uuid())
  monitor_id String
  status     ResponseStatus
  statusCode Int?
  message    String?
  data       Json?
  time_taken Int?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  monitor    Monitor        @relation(fields: [monitor_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum AuthProvider {
  EMAIL_PASSWORD @map("email-password")
  GOOGLE         @map("google")
}

enum MonitorType {
  WEBSITE @map("website")
  API     @map("api")
}

enum ResponseStatus {
  SUCCESS @map("success")
  ERROR   @map("error")
}

enum RequestMethodType {
  GET    @map("get")
  POST   @map("post")
  PUT    @map("put")
  PATCH  @map("patch")
  DELETE @map("delete")
}
