generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  EMAIL_PASSWORD @map("email-password")
  GOOGLE         @map("google")
}

enum MonitorType {
  WEBSITE @map("website")
  API     @map("api")
}

enum RequestMethodType {
  GET    @map("get")
  POST   @map("post")
  PUT    @map("put")
  PATCH  @map("patch")
  DELETE @map("delete")
}

model User {
  id             String       @id @default(uuid())
  name           String
  email          String       @unique
  password       String?
  email_verified Boolean      @default(false)
  auth_provider  AuthProvider
  monitors       Int          @default(3)
  avatar         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Monitor        Monitor[]
}

model Monitor {
  id        String            @id @default(uuid())
  name      String?
  user_id   String
  endpoint  String
  type      MonitorType
  is_active Boolean           @default(true)
  method    RequestMethodType @default(GET)
  payload   Json?
  headers   Json?

  // Foreign key relationship to User model
  user User @relation(fields: [user_id], references: [id])
}
