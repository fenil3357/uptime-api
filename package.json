{
  "name": "uptime-api",
  "version": "1.0.0",
  "description": "Api server for uptime",
  "exports": "./index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --noEmit --watch & tsx watch ./src/server.ts",
    "start": "node ./build/src/server.js",
    "reset": "prisma migrate reset -y",
    "migrate:dev": "prisma migrate dev --name",
    "migrate:undo": "prisma migrate dev --rollback",
    "migrate:rollback": "prisma migrate resolve --rolled-back"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "uptime"
  ],
  "author": "Fenil Rami",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "amqplib": "^0.10.5",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.28.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "googleapis": "^144.0.0",
    "got": "^14.4.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "openai": "^4.83.0",
    "p-map": "^7.0.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/got": "^9.6.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.16",
    "prisma": "^5.21.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "type": "module"
}
